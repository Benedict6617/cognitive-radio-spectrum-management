# Frequency range simulated for wideband scanning (Hz)
SCAN_FREQ_START_HZ=400000000
SCAN_FREQ_END_HZ=6000000000
CHANNEL_BANDWIDTH_HZ=5000000

# Cooperative sensing: minimum weighted-vote confidence to declare a channel occupied
FUSION_OCCUPIED_THRESHOLD=0.55

# Power control loop
POWER_CONTROL_TARGET_SINR_DB=10.0
POWER_CONTROL_MAX_ITERATIONS=50
POWER_CONTROL_MAX_TX_POWER_DBM=30.0

# Forecaster
FORECAST_HORIZON_STEPS=6
MODEL_PATH=./models/usage_forecaster.joblib

API_TITLE=SpectrumSense Cognitive Radio Management API
API_ENV=development
